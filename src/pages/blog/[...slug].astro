---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/blog.css';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts
		.filter((post: CollectionEntry<'blog'>) => !post.data.draft)
		.map((post: CollectionEntry<'blog'>) => ({
			params: { slug: post.slug },
			props: { post },
		}));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await post.render();

const title = `${post.data.title} | DBAI`;
const description = post.data.description;
const formattedDate = post.data.publishDate.toLocaleDateString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});
const baseUrl = Astro.site?.toString() ?? Astro.url.origin;
const canonical = new URL(`/blog/${post.slug}/`, baseUrl).toString();
const imageUrl = post.data.hero ? new URL(post.data.hero, baseUrl).toString() : undefined;
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.publishDate.toISOString(),
	author: {
		'@type': 'Person',
		name: post.data.author ?? 'DBAI',
	},
	publisher: {
		'@type': 'Organization',
		name: 'DBAI',
		url: baseUrl,
	},
	mainEntityOfPage: canonical,
	image: imageUrl ? [imageUrl] : undefined,
};
---

<BaseLayout
	title={title}
	description={description}
	canonical={canonical}
	image={imageUrl}
	author={post.data.author ?? 'DBAI'}
	type="article"
	structuredData={structuredData}>
	<a class="skip-link" href="#main">Skip to content</a>
	<div class="page page--blog">
		<header class="site-header container">
			<div class="brand">
				<span class="brand-mark">AI</span>
				<div>
					<div class="brand-name">DBAI</div>
					<div class="brand-tag">Notes from an AI engineer in the Microsoft ecosystem</div>
				</div>
			</div>
			<nav class="site-nav" aria-label="Primary">
				<a href="/">Home</a>
				<a href="/blog">Blog</a>
				<a href="/#subscribe">Subscribe</a>
			</nav>
			<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
				<span class="theme-toggle__icon" aria-hidden="true"></span>
				<span class="theme-toggle__label" data-theme-label>Dark mode</span>
			</button>
		</header>

		<main id="main" class="main container">
			<article class="post-detail">
				<header class="post-detail__header">
					<p class="eyebrow">Blog post</p>
					<h1>{post.data.title}</h1>
					<p class="section-lede">{post.data.description}</p>
					<div class="post-meta">
						{post.data.tags?.length
							? post.data.tags.map((tag: string) => <span class="post-tag">{tag}</span>)
							: null}
						<span>{formattedDate}</span>
						{post.data.readingTime ? <span>{post.data.readingTime}</span> : null}
					</div>
				</header>
				<div class="post-body">
					<Content />
				</div>
				<div class="post-detail__footer">
					<a class="text-link" href="/blog">Back to the blog</a>
				</div>
			</article>
		</main>

		<footer class="site-footer container">
			<div class="footer-left">
				<div class="brand-name">DBAI</div>
				<p>Designed for clarity, safety, and shipping real AI.</p>
			</div>
			<div class="footer-links">
				<a href="/">Home</a>
				<a href="/blog">Archive</a>
				<a href="/#subscribe">Subscribe</a>
			</div>
		</footer>
	</div>
</BaseLayout>
