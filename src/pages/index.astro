---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const title = 'DBAI - Field notes from an AI engineer';
const description =
	'A single-page AI blog landing focused on Copilot Studio, the Microsoft AI ecosystem, and modern AI advances.';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 3);

const featuredPost = posts[0];

const formatDate = (date) =>
	date.toLocaleDateString('en-US', {
		month: 'short',
		day: 'numeric',
		year: 'numeric',
	});
---

<BaseLayout title={title} description={description}>
	<a class="skip-link" href="#main">Skip to content</a>
	<div class="page">
		<header class="site-header container">
			<div class="brand">
				<span class="brand-mark">AI</span>
				<div>
					<div class="brand-name">DBAI</div>
					<div class="brand-tag">Notes from an AI engineer building in the Microsoft ecosystem</div>
				</div>
			</div>
			<nav class="site-nav" aria-label="Primary">
				<a href="#latest">Latest</a>
				<a href="/blog">Blog</a>
				<a href="#subscribe">Subscribe</a>
			</nav>
			<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
				<span class="theme-toggle__icon" aria-hidden="true"></span>
				<span class="theme-toggle__label" data-theme-label>Dark mode</span>
			</button>
		</header>

		<main id="main" class="main">
			<section class="hero container" id="overview">
				<div class="hero-copy">
					<p class="eyebrow reveal">Issue 01 - Launch Edition</p>
					<h1 class="hero-title reveal delay-1">
						Build with <em>responsible</em> AI, ship with clarity.
					</h1>
					<p class="lede reveal delay-2">
						DBAI tracks what matters in Copilot Studio, Azure AI, and
						the Microsoft ecosystem. Every post is written by an AI engineer for
						teams turning prototypes into production.
					</p>
					<div class="hero-actions reveal delay-3">
						<a class="button primary" href="#subscribe">Subscribe</a>
						<a class="button ghost" href="#latest">Read the latest</a>
					</div>
					<div class="hero-meta reveal delay-4">
						<div>
							<p class="meta-label">Cadence</p>
							<p class="meta-value">Weekly engineering notes</p>
						</div>
						<div>
							<p class="meta-label">Focus</p>
							<p class="meta-value">Copilot Studio, Azure AI, enterprise rollout</p>
						</div>
						<div>
							<p class="meta-label">Format</p>
							<p class="meta-value">Guides, playbooks, and trend briefs</p>
						</div>
					</div>
				</div>
			<div class="hero-art reveal delay-2">
				{featuredPost ? (
					<div class="hero-card">
						<p class="badge">Latest post</p>
						<h3>{featuredPost.data.title}</h3>
						<p>{featuredPost.data.description}</p>
						<a class="text-link" href={`/blog/${featuredPost.slug}/`}>Read now</a>
					</div>
				) : (
					<div class="hero-card">
						<p class="badge">Coming first</p>
						<h3>Designing Copilots that earn trust</h3>
						<p>
							A launch essay on guardrails, grounding data, and how to keep copilots
							aligned with user intent.
						</p>
						<a class="text-link" href="#subscribe">Get notified</a>
					</div>
				)}
				<div class="hero-card alt">
					<p class="badge">Playbook</p>
					<h3>Copilot Studio setup checklist</h3>
					<p>
						A practical guide to connectors, security boundaries, and monitoring
						that teams can reuse.
					</p>
					<a class="text-link" href="/blog">Browse the blog</a>
				</div>
			</div>
		</section>

			<section class="section container" id="latest">
				<div class="section-header">
					<p class="eyebrow">Latest</p>
					<h2>Latest from the AI journal</h2>
					<p class="section-lede">
						New releases on Copilot Studio, Azure AI, and the Microsoft ecosystem.
					</p>
				</div>
				{posts.length ? (
					<div class="post-grid">
						{posts.map((post) => (
							<article class="post-card">
								<div class="post-meta">
									<span class="post-tag">{post.data.tags?.[0] || 'AI'}</span>
									<span>{formatDate(post.data.publishDate)}</span>
									<span>{post.data.readingTime ?? '5 min read'}</span>
								</div>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
								<a class="text-link" href={`/blog/${post.slug}/`}>Read the full post</a>
							</article>
						))}
					</div>
				) : (
					<div class="post-card">
						<div class="post-meta">
							<span class="post-tag">Launching soon</span>
							<span>Pipeline ready</span>
							<span>0 posts yet</span>
						</div>
						<h3>The first AI briefings are in edit</h3>
						<p>
							Expect guides on Copilot Studio build patterns, Azure AI architecture,
							and the newest Microsoft AI announcements.
						</p>
						<a class="text-link" href="#subscribe">Notify me on launch</a>
					</div>
				)}
			</section>

			<section class="section container" id="subscribe">
				<div class="subscribe-card">
					<div>
						<p class="eyebrow">Newsletter</p>
						<h2>Get the AI engineer's digest.</h2>
						<p>One email per week. Copilot Studio insights, Microsoft AI updates, and pragmatic guidance.</p>
					</div>
					<form
						class="subscribe-form"
						id="subscribe-form"
						action="https://script.google.com/macros/s/AKfycbx9tJv9afqdovfxcu_zd4wdqWkUjb-iOUqBAVX8Enx3I1gk6ju12ZqmRH6G0mWd1mZA/exec"
						method="post"
						data-sheet-endpoint="https://script.google.com/macros/s/AKfycbx9tJv9afqdovfxcu_zd4wdqWkUjb-iOUqBAVX8Enx3I1gk6ju12ZqmRH6G0mWd1mZA/exec"
						aria-label="Newsletter signup"
					>
						<label class="sr-only" for="email">Email address</label>
						<input
							id="email"
							name="email"
							type="email"
							placeholder="you@email.com"
							required
						/>
						<input type="hidden" name="page" value="" />
						<input type="hidden" name="referrer" value="" />
						<button class="button primary" type="submit">Join the list</button>
					</form>
					<p class="form-status" data-form-status role="status" aria-live="polite"></p>
					<p class="subscribe-note">You can opt out anytime. We never share your address.</p>
				</div>
			</section>

			<section class="section container" id="sign">
				<div class="signboard">
					<div class="signboard-content">
						<p class="eyebrow">Editorial standards</p>
						<h2>Built like a real blog, not a landing page.</h2>
						<p>
							Every post follows a clear structure so busy teams can skim, learn, and
							ship with confidence.
						</p>
						<ul class="signboard-list">
							<li><strong>TL;DR</strong> summary at the top of each post.</li>
							<li><strong>Step-by-step</strong> build notes with code-friendly blocks.</li>
							<li><strong>Source links</strong> to Microsoft docs and references.</li>
						</ul>
						<div class="signboard-actions">
							<a class="button primary" href="#subscribe">Get launch updates</a>
							<a class="button ghost" href="#latest">See latest posts</a>
						</div>
					</div>
					<div class="signboard-panel">
						<span class="signboard-title">Blogging rules</span>
						<span class="signboard-direction">-></span>
					</div>
				</div>
			</section>
		</main>

	<footer class="site-footer container">
		<div class="footer-left">
			<div class="brand-name">DBAI</div>
			<p>Designed for clarity, safety, and shipping real AI.</p>
		</div>
			<div class="footer-links">
				<a href="#overview">Top</a>
				<a href="#latest">Archive</a>
				<a href="#subscribe">Subscribe</a>
			</div>
		</footer>
	</div>
</BaseLayout>

<script is:inline>
	(() => {
		const form = document.querySelector('#subscribe-form');
		if (!form) return;

		const status = form.parentElement?.querySelector('[data-form-status]');
		const endpoint = form.dataset.sheetEndpoint;
		const pageField = form.querySelector('input[name="page"]');
		const referrerField = form.querySelector('input[name="referrer"]');

		const syncMeta = () => {
			if (pageField) pageField.value = window.location.href;
			if (referrerField) referrerField.value = document.referrer || 'direct';
		};

		syncMeta();

		const setStatus = (message, state) => {
			if (!status) return;
			status.textContent = message;
			status.classList.remove('is-success', 'is-error');
			if (state) status.classList.add(state);
		};

		form.addEventListener('submit', async (event) => {
			if (!endpoint) return;
			event.preventDefault();
			setStatus('Submitting...', '');

			try {
				const formData = new FormData(form);
				await fetch(endpoint, {
					method: 'POST',
					body: formData,
					mode: 'no-cors',
				});
				form.reset();
				syncMeta();
				setStatus('Thanks. You are on the list.', 'is-success');
			} catch (error) {
				setStatus('Something went wrong. Please try again.', 'is-error');
			}
		});
	})();
</script>
